{% macro terrarium_host_tls(domain) %}
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ domain }}"
{% endmacro %}
http:
  middlewares:
    admin-forward-auth:
      forwardAuth:
        address: http://127.0.0.1:{{ terrarium_oauth2_proxy_port | default(4180) }}/
        trustForwardHeader: true
        authResponseHeaders:
          - X-Auth-Request-User
          - X-Auth-Request-Email
          - X-Auth-Request-Groups
    traefik-dashboard-root-redirect:
      redirectRegex:
        regex: "^https?://([^/]+)/?$"
        replacement: "https://$1/dashboard/"
{% if terrarium_idp_mode == 'local' %}
    zitadel-root-rewrite:
      replacePath:
        path: /ui/v2/login/
    zitadel-strip-api:
      stripPrefix:
        prefixes:
          - /api
        forceSlash: false
{% endif %}
  routers:
    cockpit-oauth2:
      entryPoints:
        - websecure
      rule: Host(`{{ terrarium_manage_domain }}`) && PathPrefix(`/oauth2/`)
      service: oauth2-proxy
      priority: 500
{{ terrarium_host_tls(terrarium_manage_domain) }}
    proxy-oauth2:
      entryPoints:
        - websecure
      rule: Host(`{{ terrarium_proxy_domain }}`) && PathPrefix(`/oauth2/`)
      service: oauth2-proxy
      priority: 500
{{ terrarium_host_tls(terrarium_proxy_domain) }}
    cockpit:
      entryPoints:
        - websecure
      rule: Host(`{{ terrarium_manage_domain }}`)
      middlewares:
        - admin-forward-auth
      service: cockpit
{{ terrarium_host_tls(terrarium_manage_domain) }}
    traefik-dashboard-root:
      entryPoints:
        - websecure
      rule: Host(`{{ terrarium_proxy_domain }}`) && Path(`/`)
      middlewares:
        - admin-forward-auth
        - traefik-dashboard-root-redirect
      service: api@internal
{{ terrarium_host_tls(terrarium_proxy_domain) }}
    traefik-dashboard:
      entryPoints:
        - websecure
      rule: Host(`{{ terrarium_proxy_domain }}`) && (PathPrefix(`/dashboard`) || PathPrefix(`/api`))
      middlewares:
        - admin-forward-auth
      service: api@internal
{{ terrarium_host_tls(terrarium_proxy_domain) }}
    lxd:
      entryPoints:
        - websecure
      rule: Host(`{{ terrarium_lxd_domain }}`)
      service: lxd
{{ terrarium_host_tls(terrarium_lxd_domain) }}
{% if terrarium_idp_mode == 'local' %}
    zitadel-root:
      entryPoints:
        - websecure
      rule: Host(`{{ terrarium_auth_domain }}`) && Path(`/`)
      middlewares:
        - zitadel-root-rewrite
      service: zitadel-login
      priority: 400
{{ terrarium_host_tls(terrarium_auth_domain) }}
    zitadel-login:
      entryPoints:
        - websecure
      rule: Host(`{{ terrarium_auth_domain }}`) && PathPrefix(`/ui/v2/login`)
      service: zitadel-login
      priority: 250
{{ terrarium_host_tls(terrarium_auth_domain) }}
    zitadel-api-alias:
      entryPoints:
        - websecure
      rule: Host(`{{ terrarium_auth_domain }}`) && PathPrefix(`/api`)
      middlewares:
        - zitadel-strip-api
      service: zitadel-api
      priority: 200
{{ terrarium_host_tls(terrarium_auth_domain) }}
    zitadel-canonical:
      entryPoints:
        - websecure
      rule: Host(`{{ terrarium_auth_domain }}`) && !PathPrefix(`/ui/v2/login`) && !PathPrefix(`/api`) && !Path(`/`)
      service: zitadel-api
      priority: 100
{{ terrarium_host_tls(terrarium_auth_domain) }}
{% endif %}
  services:
    oauth2-proxy:
      loadBalancer:
        servers:
          - url: http://127.0.0.1:{{ terrarium_oauth2_proxy_port | default(4180) }}
    cockpit:
      loadBalancer:
        servers:
          - url: http://127.0.0.1:9090
    lxd:
      loadBalancer:
        serversTransport: lxd-loopback
        passHostHeader: true
        servers:
          - url: https://127.0.0.1:8443
{% if terrarium_idp_mode == 'local' %}
    zitadel-login:
      loadBalancer:
        servers:
          - url: http://127.0.0.1:8083
    zitadel-api:
      loadBalancer:
        servers:
          - url: h2c://127.0.0.1:8082
{% endif %}
  serversTransports:
    lxd-loopback:
      insecureSkipVerify: true
